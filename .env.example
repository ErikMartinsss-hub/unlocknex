# ─────────────────────────────────────────────────────
# Variáveis de ambiente — UnlockNex
# Copie para `.env.local` e preencha com valores reais.
# NUNCA commite segredos reais.
# ─────────────────────────────────────────────────────

# Mercado Pago — Access Token (fallback quando não há auto-refresh)
MERCADO_PAGO_ACCESS_TOKEN=

# Mercado Pago — Public Key (cliente)
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=

# Auto-refresh do token via client_credentials (obrigatórios juntos)
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# Validação dos webhooks (signing secret da aplicação)
MERCADO_PAGO_WEBHOOK_SECRET=
# (opcional, testes) token próprio para simular webhooks
MERCADO_PAGO_WEBHOOK_TOKEN=

# URL pública do site (notificações e retorno do checkout)
SITE_URL=https://www.unlocknex.com.br
NEXT_PUBLIC_SITE_URL=https://www.unlocknex.com.br

# Firebase — Admin SDK (service account em base64)
FIREBASE_SERVICE_ACCOUNT_B64=

# Firebase — cliente
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# (opcional) API HeartUnlocks
HEARTUNLOCKS_BASE_URL=
HEARTUNLOCKS_TOKEN=